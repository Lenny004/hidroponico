#!/bin/sh
# Elimina Co-authored-by de Cursor/IA antes de crear el commit.
msg=$1
[ -f "$msg" ] || exit 0

repo=$(git rev-parse --show-toplevel 2>/dev/null) || repo=""
if [ -n "$repo" ] && command -v node >/dev/null 2>&1 && [ -f "$repo/scripts/quitar-coautor-cursor.mjs" ]; then
  exec node "$repo/scripts/quitar-coautor-cursor.mjs" strip "$msg"
fi

tmp="${msg}.tmp.$$"
grep -v -i -E 'Co-authored-by:.*Cursor|cursoragent@cursor\.com|Made with Cursor|Generated by Cursor' "$msg" > "$tmp" || true
mv "$tmp" "$msg"
