generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Grafo persistido (producción). Distinto del grafo de construcción del cliente.
/// La sincronización es automática (docs/asunciones.md).
model Nodo {
  id               String   @id @default(uuid())
  tipoCultivo      String
  /// JSONB con las variables del boceto (number | null).
  variables        Json
  plagas           Json?
  solucion_plagas  String?
  comentarios      String?
  posicionX        Float?
  posicionY        Float?
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt
  aristasOrigen    Arista[] @relation("AristaOrigen")
  aristasDestino   Arista[] @relation("AristaDestino")

  @@map("nodos")
}

model Arista {
  id        String   @id @default(uuid())
  origenId  String
  destinoId String
  /// Reservado por si una arista deja de ser solo visual. Null en el MVP.
  categoria String?
  creadoEn  DateTime @default(now())
  origen    Nodo     @relation("AristaOrigen", fields: [origenId], references: [id], onDelete: Cascade)
  destino   Nodo     @relation("AristaDestino", fields: [destinoId], references: [id], onDelete: Cascade)

  @@unique([origenId, destinoId])
  @@map("aristas")
}
