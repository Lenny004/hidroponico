{
  "name": "hidroponico",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @hidroponico/frontend --filter @hidroponico/backend dev",
    "dev:frontend": "pnpm --filter @hidroponico/frontend dev",
    "dev:backend": "pnpm --filter @hidroponico/backend dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter \"./apps/**\" --filter \"./packages/**\" --if-present typecheck",
    "test": "pnpm -r --filter \"./apps/**\" --filter \"./packages/**\" --if-present test",
    "build": "pnpm -r --filter \"./apps/**\" --filter \"./packages/**\" --if-present build"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
